# --- App ---
APP_NAME=DripsLens
APP_VERSION=0.1.0
DEBUG=false
SCHEDULER_ENABLED=true
INITIAL_REFRESH_ON_STARTUP=true

# --- Database ---
# Postgres (docker-compose default):
DATABASE_URL=postgresql+psycopg2://drips:drips@localhost:5432/dripslens
# SQLite (local dev without docker):
# DATABASE_URL=sqlite:///./dripslens.db

# --- Redis ---
# Leave empty to run without Redis (falls back to in-process cache)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# --- Refresh engine ---
REFRESH_INTERVAL_HOURS=6

# --- GitHub ---
# Required: unauthenticated calls are capped at 60 req/h, which the 6-hour
# refresh cycle (3-5 calls/repo + 2 more for Stellar discovery) exhausts almost
# immediately. A token raises the limit to 5,000 req/h.
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com
GITHUB_MAX_RETRIES=3

# --- Drips ---
DRIPS_REPOS_URL=https://drips.network/wave/stellar/repos

# --- Stellar ---
STELLAR_HORIZON_URL=https://horizon.stellar.org
# Optional: Soroban RPC endpoint for verifying contract (C...) addresses
STELLAR_RPC_URL=
